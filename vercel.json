{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/**,frontend/**}",
      "excludeFiles": "{tests/**,.venv/**,data/**,.pytest_cache/**,**/__pycache__/**}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
