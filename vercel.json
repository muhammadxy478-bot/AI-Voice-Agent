{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/**,frontend/**}",
      "excludeFiles": "{tests/**,.venv/**,data/**,.pytest_cache/**,**/__pycache__/**}"
    }
  }
}
